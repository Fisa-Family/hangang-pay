# hangang-pay-be deploy/.env 템플릿 (실제 .env는 커밋 금지)
# EC2: start.sh가 SSM Parameter Store + IMDS로 자동 생성한다.
# 온프레: 이 파일을 복사해 .env로 채운다.

# --- 앱 이미지 ---
APP_IMAGE=857291404781.dkr.ecr.ap-northeast-2.amazonaws.com/hangang-pay-be:prod-latest

# --- 앱 런타임 (기존 SSM 키) ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
BANK_BASE_URL=
REDIS_HOST=
REDIS_PORT=
VERCEL_PRODUCTION_URL=

# --- Sentry (크리덴셜) ---
SENTRY_DSN=
SENTRY_RELEASE=

# --- Grafana Cloud (크리덴셜) ---
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_PROM_PASSWORD=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_PASSWORD=

# --- Alloy 라벨/타겟 (비밀 아님, 서버마다 다름) ---
ALLOY_SERVICE=hangang-pay-be
DEPLOY_TARGET=cloud         # cloud | onprem
ALLOY_ENV=prod             # prod | test
ALLOY_COLOR=blue           # blue | green | (온프레는 빈값)
APP_SCRAPE_TARGET=app:8080 # compose 서비스명 기준 (호스트 포트와 무관)
APP_CONTAINER_NAME=app     # 로그 필터용 컨테이너명 (compose container_name과 일치)
INSTANCE_ID=               # EC2 instance-id 또는 hostname (start.sh가 채움)
